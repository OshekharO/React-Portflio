# Cloudflare Pages headers for OSHEKHARO.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Safe default for everything. Note: the build emits no inline <script>, so
# script-src can stay locked to 'self'. Inline style attributes (skill bars,
# staggered delays) require 'unsafe-inline' for styles only.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

# Hashed build assets never change under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else is small and may be edited; revalidate rather than pinning.
/favicon.svg
  Cache-Control: public, max-age=3600

/index.html
  Cache-Control: public, max-age=0, must-revalidate