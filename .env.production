# Absolute site origin, injected at build time by the sitemap() and seo() plugins
# in vite.config.js: <link rel="canonical">, og:url, absolute og:image and
# twitter:image, dist/sitemap.xml, and the Sitemap: line in dist/robots.txt.
#
# Vite loads this file automatically for `vite build` (mode = production), so a
# plain `npm run build` produces correct absolute URLs without setting anything
# in the shell. Public URL, not a secret — safe to commit.
VITE_SITE_URL=https://saksham.eu.org